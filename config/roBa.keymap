#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    //automouse-layer = <3>;
    scroll-layers = <3>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q           &kp W         &kp E    &kp R                        &kp T                                                          &kp Y          &kp U  &lt 3 I  &kp O           &kp P
&kp A           &kp S         &kp D    &kp F                        &kp G                        &kp COLON        &lt 4 C_AC_HOME  &kp H          &kp J  &kp K    &kp L           &kp UP_ARROW
&kp LEFT_SHIFT  &kp Z         &kp X    &kp C                        &kp V                        &kp SLASH        &kp END          &kp B          &kp N  &kp M    &kp LEFT_ARROW  &kp RIGHT_ARROW
&kp LCTRL       &kp LEFT_ALT  &kp TAB  &lt_to_layer_0 1 LANGUAGE_2  &lt_to_layer_0 2 LANGUAGE_1  &lt 3 SPACE      &lt 3 ENTER      &kp BACKSPACE                                  &kp DOWN_ARROW
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        SYMBOL {
            bindings = <
&kp AT_SIGN      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON  &kp COLON                                             &kp N7        &kp N8        &kp N9        &kp EQUAL  &kp PLUS
&kp QUESTION     &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp TILDE      &kp MINUS       &kp PIPE               &kp BACKSLASH  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp CARET  &kp MINUS
&kp EXCLAMATION  &kp LESS_THAN         &kp GREATER_THAN       &kp COMMA      &kp PERIOD      &kp UNDERSCORE         &kp PERCENT    &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp N0     &kp ASTERISK
&kp DOLLAR       &kp AMPERSAND         &kp HASH               &trans         &kp APOSTROPHE  &kp DOUBLE_QUOTES      &kp ESCAPE     &kp DELETE                                           &kp SLASH
            >;
        };

        FUNCTION {
            bindings = <
&kp F11             &kp F2            &kp F3       &kp F4   &kp F5                                          &kp RG(D)               &kp RG(M)                &kp RG(RS(M))  &trans              &kp RG(RS(S))
&kp F6              &kp F7            &kp F8       &kp F9   &kp F10  &kp C_VOLUME_UP        &kp RG(RC(D))   &trans                  &trans                   &trans         &trans              &kp RG(UP_ARROW)
&kp LG(LEFT_SHIFT)  &kp F12           &kp F13      &kp F14  &kp F15  &kp C_VOLUME_DOWN      &kp RG(RC(F4))  &kp RG(RC(LEFT_ARROW))  &kp RG(RC(RIGHT_ARROW))  &trans         &kp RG(LEFT_ARROW)  &kp RG(RIGHT_ARROW)
&kp LG(LCTRL)       &kp LG(LEFT_ALT)  &kp LG(TAB)  &trans   &trans   &trans                 &kp ESCAPE      &kp DELETE                                                                          &kp RG(DOWN_ARROW)
            >;
        };

        MOUSE+SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &mkp MB1            &mkp MB2
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &kp RA(LEFT_ARROW)  &kp RA(RIGHT_ARROW)
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &kp RS(RC(TAB))     &kp RC(TAB)
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                      &trans
            >;
        };

        BLUETOOTH {
            bindings = <
&trans  &trans  &trans  &trans  &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
